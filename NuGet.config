<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Shinra suite packages (ShinraCC.Update). Private GitHub Packages feed for the ShinraEngineer
         account. Set GITHUB_PACKAGES_TOKEN to a PAT with read:packages locally and in CI; no secret
         is stored in this file. -->
    <add key="shinra-github" value="https://nuget.pkg.github.com/ShinraEngineer/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <shinra-github>
      <add key="Username" value="ShinraEngineer" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </shinra-github>
  </packageSourceCredentials>
</configuration>
